# Airtable personal access token (Account settings -> Developer hub -> Personal access tokens)
# Needs data.records:read + data.records:write scopes on the ClientFlow AI base.
AIRTABLE_TOKEN=patXXXXXXXXXXXXXX.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional overrides — defaults already point at the ClientFlow AI base.
# AIRTABLE_BASE_ID=appmYr2NnWtdIoKwS
# AIRTABLE_CALL_LOG_TABLE_ID=tblvskjHbDfauOo7r
# AIRTABLE_APPOINTMENTS_TABLE_ID=tblNIfe3DCXKllVM5
# AIRTABLE_MONTHLY_SUMMARY_TABLE_ID=tblh2PaNByS6rqpP1

# Optional: shared secret Ulio sends back as the `x-ulio-signature` header.
# Leave unset until you've configured a matching value in Ulio.
# ULIO_WEBHOOK_SECRET=

PORT=3000
